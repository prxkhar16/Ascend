# ==============================================================================
# ASCEND LIFE OS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# In Phase 1, the app operates fully offline with realistic mock data & local persistence.
# For Phase 2 (Live Firebase & Gemini AI), duplicate this file as `.env.local` and add your keys.

# Firebase Authentication & Cloud Firestore
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini AI Coach (Interactions API / Flash 2.5)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
